[project]
title = extension-rustore-push
dependencies#0 = https://github.com/andsve/dirtylarry/archive/master.zip

[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 640
height = 1136

[library]
include_dirs = extension-rustore-push

[android]
input_method = HiddenInputField
package = ru.rustore.defoldpush
rustore_project_id = -Yv4b5cM2yfXm0bZyY6Rk7AHX8SrHmLI
minimum_sdk_version = 24
manifest = /extension-rustore-push/manifests/android/ExtendedAndroidManifest.xml
target_sdk_version = 34

[native_extension]
app_manifest = /generated.appmanifest

